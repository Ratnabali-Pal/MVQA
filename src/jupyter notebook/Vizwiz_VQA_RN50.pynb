    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "time: 734 ms (started: 2025-02-21 08:34:22 +01:00)\n"
     ]
    }
   ],
   "source": [
    "torch.save(encodings,\"modelRN50.pt\")\n"
   ]
  },
