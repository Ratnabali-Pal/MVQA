   "source": [
    "def explode_df(df, col):\n",
    "    df = df.explode(col).reset_index(drop=True)\n",
    "    df = df.merge(pd.json_normalize(df[col]), left_index=True, right_index=True).drop(col, axis=1)\n",
    "    return df"
   ]
  },
